# options for nanopb
# https://jpa.kapsi.fi/nanopb/docs/reference.html#proto-file-options

*OneTimePreKey.key                           max_size:32 fixed_length:true

*PreKeyBundle.identity_key                   max_size:32 fixed_length:true
*PreKeyBundle.signed_pre_key                 max_size:32 fixed_length:true
*PreKeyBundle.pre_key_signature              max_size:64 fixed_length:true
*PreKeyBundle.one_time_pre_keys              max_count:10

*OneTimePreKeyBundle.one_time_pre_keys        max_count:5

*RequestBundle.public_key                   max_size:32 fixed_length:true

*InitialMessage.ephermal_key                 max_size:32 fixed_length:true